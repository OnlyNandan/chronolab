# ChronoLab environment configuration
# Copy this file to `.env` and fill in the block below by hand.
# Everything after that block is written automatically by scripts/bootstrap.sh — do not fill it in yourself.

# ─── FILL THESE IN BY HAND (everything below is generated by bootstrap.sh) ───
AWS_MODE=local                  # local = LocalStack + Ollama, cloud = real AWS + Bedrock
AWS_REGION=ap-south-1           # region for S3 / DynamoDB / EC2 / Cognito / AVP
BEDROCK_REGION=ap-south-1       # change if Bedrock model access is only granted in another region
RESOURCE_SUFFIX=                # your initials or any short unique string (bucket names must be globally unique)
# ─────────────────────────────────────────────────────────────────────────────

# ── Local emulation (used only when AWS_MODE=local) ──
LOCALSTACK_ENDPOINT_URL=http://localhost:4566
OLLAMA_HOST=http://localhost:11434
OLLAMA_VISION_MODEL=llava:7b
OLLAMA_TEXT_MODEL=qwen2.5:3b

# ── Bedrock models (used only when AWS_MODE=cloud) — override if your account's ──
# ── model access grant is for different model IDs than these defaults           ──
BEDROCK_VISION_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_TEXT_MODEL_ID=anthropic.claude-3-5-haiku-20241022-v1:0

# ── Cognito test users (Phase 3) — change these before a real deploy ──
COGNITO_DOCTOR_USERNAME=doctor@chronolab.demo
COGNITO_DOCTOR_PASSWORD=ChangeMe123!
COGNITO_PATIENT_USERNAME=patient@chronolab.demo
COGNITO_PATIENT_PASSWORD=ChangeMe123!
COGNITO_PATIENT_ID=PT-1002

# ── Frontend build-time config (Phase 4) ──
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000

# ══════════════════════════════════════════════════════════════════════════
# GENERATED BY scripts/bootstrap.sh — do not edit by hand, do not commit real values
# ══════════════════════════════════════════════════════════════════════════
# S3_BUCKET_NAME=
# DYNAMODB_TABLE_NAME=
# COGNITO_USER_POOL_ID=
# COGNITO_APP_CLIENT_ID=
# AVP_POLICY_STORE_ID=
# EC2_IAM_INSTANCE_PROFILE_ARN=
# ECR_REPOSITORY_URI=
# EC2_PUBLIC_DNS=
